rules_version = '2';

// ============================================================
// STORAGE SECURITY RULES
// Same idea as firestore.rules — only your approved UID(s) can
// upload/view question images. Paste your UID below (same one you
// used in firestore.rules), then paste this whole file into
// Firebase console -> Storage -> Rules tab, and click "Publish".
// ============================================================

function isAllowedUser() {
  return request.auth != null && request.auth.uid in [
    "PASTE_YOUR_USER_UID_HERE"
    // , "ANOTHER_ALLOWED_UID_HERE"
  ];
}

service firebase.storage {
  match /b/{bucket}/o {
    match /question-images/{allPaths=**} {
      allow read, write: if isAllowedUser();
    }
  }
}
